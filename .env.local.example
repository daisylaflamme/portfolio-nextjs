# Contact form + resume-visit emails (Resend) – copy to .env.local and fill in.
# Get API key: https://resend.com/api-keys
# For testing you can use from: onboarding@resend.dev (Resend’s test sender).
#
# Same vars power:
# - /api/contact (contact form)
# - /api/resume-visit (email when utm_source=resume)

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=laflammedaisy@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional: home page language chart. Fine-grained token, public repositories read-only (see README).
GITHUB_TOKEN=

# Optional: live data for the Online Retail dashboard (see db/online-retail/README.md).
# The read-only online_retail_reader role through Supabase's transaction pooler (port 6543).
# Leave empty to use the committed snapshot; the build and tests never need it.
ONLINE_RETAIL_DATABASE_URL=
